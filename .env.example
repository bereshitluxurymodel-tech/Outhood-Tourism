# --- Database (Neon Postgres) ---
# In Neon: use the "pooled" connection string for DATABASE_URL and the
# "direct" connection string (no -pooler) for DIRECT_URL, which Prisma
# migrations need.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/outhood?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/outhood?sslmode=require"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-generated-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Payments (MVP: mock only, no real keys needed yet) ---
PAYMENT_PROVIDER="MOCK_SANDBOX"

# --- Storage (MVP: local dev storage; swap for S3-compatible bucket later) ---
STORAGE_DRIVER="local"
